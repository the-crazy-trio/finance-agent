# Required secrets
OPENROUTER_API_KEY=your-openrouter-api-key
TINVEST_READONLY_TOKEN=your-tinvest-readonly-token

# Optional runtime config
APP_ENV=dev
DEFAULT_MODEL_INTENT=openai/gpt-4.1-mini
DEFAULT_MODEL_SYNTHESIS=openai/gpt-4.1
REQUEST_TIMEOUT_MS=120000
TOOL_TIMEOUT_MS=60000
LLM_TIMEOUT_MS=90000
MAX_RETRIES_TRANSIENT=2
TOKENS_INTENT_MAX=1500
TOKENS_SYNTHESIS_MAX=4000
PORTFOLIO_SNAPSHOT_MAX_AGE_MIN=60
ANALYTICS_SNAPSHOT_MAX_AGE_MIN=120
STRATEGY_FIT_MIN_COVERAGE=0.7

# Optional T-Invest SDK override
# TINVEST_GRPC_TARGET=invest-public-api.tinkoff.ru:443
